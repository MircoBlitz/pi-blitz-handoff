{
  "name": "pi-blitz-handoff",
  "version": "1.1.3",
  "description": "Carry focused task context into a genuinely fresh, natively linked Pi session with template-guided readiness checks and handoff dossiers.",
  "type": "module",
  "license": "MIT",
  "author": "Mirco Blitz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MircoBlitz/pi-blitz-handoff.git"
  },
  "homepage": "https://github.com/MircoBlitz/pi-blitz-handoff#readme",
  "bugs": {
    "url": "https://github.com/MircoBlitz/pi-blitz-handoff/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "extensions",
    "docs",
    "assets",
    "templates/call_default.cmpl",
    "templates/handoff_default.cmpl",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate": "npm test && npm run typecheck",
    "prepublishOnly": "npm run validate"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "handoff",
    "context-window",
    "compaction"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.2",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/MircoBlitz/pi-blitz-handoff/main/assets/logo.png"
  }
}
