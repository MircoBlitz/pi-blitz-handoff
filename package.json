{
  "name": "pi-simple-handoff",
  "version": "0.1.1",
  "description": "Carry focused task context into a genuinely fresh Pi session.",
  "type": "module",
  "license": "MIT",
  "author": "Mirco Blitz <mail@mircoblitz.de>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MircoBlitz/pi-simple-handoff.git"
  },
  "homepage": "https://github.com/MircoBlitz/pi-simple-handoff#readme",
  "bugs": {
    "url": "https://github.com/MircoBlitz/pi-simple-handoff/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "handoff",
    "context-window",
    "compaction"
  ],
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "validate": "npm test && npm run typecheck",
    "prepublishOnly": "npm run validate"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.2",
    "@earendil-works/pi-coding-agent": ">=0.84.2",
    "@earendil-works/pi-tui": ">=0.84.2",
    "typebox": ">=1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/node": "24.12.4",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-simple-handoff/index.ts"
    ]
  }
}
